rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Mídia de notícias
    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Mídia do blog
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Demais uploads (ex.: avatares)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
